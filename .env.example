# ── Web3Forms — form submissions, routed server-side by form type ──
WEB3FORMS_KEY_LEADS=8963b135-1e03-4b2a-8505-294d55d8dccd
WEB3FORMS_KEY_ATTORNEYS=db771495-a8b8-4877-8e8a-dd277c3bbd20
# Legacy single key — optional fallback if the two above are unset
WEB3FORMS_KEY=

# ── Cloudflare Turnstile — spam protection (Managed widget) ──
# Site key is public; secret is server-only. Leave both blank to disable the captcha
# (forms still work; the server just skips verification).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Strapi CMS base URL (no trailing slash) ──
STRAPI_URL=http://localhost:1337

# Where Strapi serves uploaded media. Only needed when STRAPI_URL is a CUSTOM domain
# (e.g. https://cms.accidentprofessionals.com) — Strapi Cloud still serves media from
# https://<project>.media.strapiapp.com, and that host must be allowlisted for images.
STRAPI_MEDIA_URL=

# ── Public site URL — canonical URLs, sitemap, OG tags ──
SITE_URL=http://localhost:3000
